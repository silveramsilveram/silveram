# Public browser settings only. Database and payment secrets belong in server/.env.
VITE_API_BASE_URL="/api"
# Shows the Checkout button and checkout pages. Cash on delivery is the available payment method.
VITE_CHECKOUT_ENABLED="true"
# Cash on delivery (default on). Must match COD_ENABLED on the API.
VITE_COD_ENABLED="true"
# Cashfree checkout: UPI apps, UPI QR code, debit/credit cards. Must match CASHFREE_ENABLED on the API.
VITE_CASHFREE_ENABLED="false"
# Dummy test-card payment option at checkout. Must match PAYMENT_TEST_MODE on the API. Turn off before launch.
VITE_TEST_PAYMENT_ENABLED="false"
VITE_NEWSLETTER_ENABLED="false"
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_ROOT_FOLDER="silveram"

# WhatsApp ordering (primary sales channel). Indian mobile: 9XXXXXXXXX or 919XXXXXXXXX.
# Leave empty and the site shows a "WhatsApp contact pending" state.
# Optional overrides. Defaults: WhatsApp 7766911777, Instagram https://www.instagram.com/silveram__
VITE_WHATSAPP_NUMBER=

# Optional public contact details shown in the footer when set.
VITE_INSTAGRAM_URL=
VITE_CONTACT_EMAIL=
