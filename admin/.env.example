# Public browser settings only. Nothing secret ever belongs in a VITE_* variable.
# API base path. Keep "/api": in development Vite proxies it to the Express API, and in production
# admin/vercel.json rewrites it to the storefront's API so the session cookie stays same-origin.
VITE_API_BASE_URL="/api"
# Optional, development only: where the Vite dev server forwards /api (default http://localhost:4000).
# ADMIN_DEV_API_TARGET="http://localhost:4000"
# Cloudinary cloud name, only used to build image previews/uploads; the signing secret stays on the server.
VITE_CLOUDINARY_CLOUD_NAME=
