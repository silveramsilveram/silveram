{
  "name": "silveram-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Silveram admin dashboard (Refine + Ant Design). Separate frontend; uses the existing Express API and Appwrite project.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --port=3100 --host=0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port=3100",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@fontsource-variable/league-spartan": "^5.3.0",
    "@fontsource/courier-prime": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@refinedev/antd": "^6.0.3",
    "@refinedev/core": "^5.0.12",
    "@refinedev/react-router": "^2.0.4",
    "@tanstack/react-query": "^5.81.5",
    "antd": "^5.29.3",
    "dayjs": "^1.11.23",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^26.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  }
}
