{
  "name": "silveram-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "appwrite:setup": "node --env-file-if-exists=.env src/scripts/appwrite-setup.js",
    "appwrite:check": "node --env-file-if-exists=.env src/scripts/appwrite-check.js",
    "upload:catalog-images": "node --env-file-if-exists=.env src/scripts/upload-catalog-images.js ../public/images/products",
    "seed:catalog": "node --env-file-if-exists=.env src/scripts/seed-catalog.js",
    "test": "node --experimental-test-module-mocks --test",
    "check": "node scripts/check-syntax.mjs",
    "admin:backfill": "node --env-file-if-exists=.env src/scripts/admin-backfill.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "node-appwrite": "^31.1.0",
    "nodemailer": "^10.3.0",
    "zod": "^4.1.12"
  }
}
