# Copy this template to server/.env for local development.
# Never commit .env files, expose API keys in VITE_* variables, or share secrets in chat.
NODE_ENV=development
PORT=4000

# Use the region-specific endpoint shown for your Appwrite Cloud project.
# Silveram's current project is in Singapore; change this if you use another region.
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
# Temporary elevated key used only by appwrite:setup; never add this to Vercel.
APPWRITE_SETUP_API_KEY=
APPWRITE_DATABASE_ID=silveram
# Collection IDs may be customized here; otherwise the names are defined in appwrite-schema.js.
APPWRITE_PROFILES_COLLECTION_ID=profiles
APPWRITE_AUTH_CHALLENGES_COLLECTION_ID=auth_challenges
APPWRITE_AUTH_CONSUMPTIONS_COLLECTION_ID=auth_consumptions
APPWRITE_SESSIONS_COLLECTION_ID=sessions
APPWRITE_RATE_LIMITS_COLLECTION_ID=rate_limits
APPWRITE_PRODUCTS_COLLECTION_ID=products
APPWRITE_ORDERS_COLLECTION_ID=orders
APPWRITE_WEBHOOK_EVENTS_COLLECTION_ID=webhook_events
APPWRITE_EMAIL_CLAIMS_COLLECTION_ID=email_claims
APPWRITE_CUSTOMERS_COLLECTION_ID=customers
# Admin dashboard collections (additive; created by appwrite:setup).
APPWRITE_PRODUCT_PRICE_HISTORY_COLLECTION_ID=product_price_history
APPWRITE_INVENTORY_MOVEMENTS_COLLECTION_ID=inventory_movements
APPWRITE_ORDER_EVENTS_COLLECTION_ID=order_events
APPWRITE_TRANSACTIONS_COLLECTION_ID=transactions

# Generate a random secret of at least 32 bytes.
OTP_PEPPER=
CRON_SECRET=
# Exact website origins allowed to call the API. Add the admin origin too (https://admin.silveram.in in
# production; http://localhost:3100 for the local admin dev server).
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100
# Number of reverse proxies in front of the API (Vercel = 1). Leave UNSET in production: it then
# defaults to 1, which makes per-IP rate limits see the real visitor IP. 0 would put every visitor
# behind one shared IP bucket.
TRUST_PROXY_HOPS=0
# Comma-separated e-mail addresses allowed into the admin. Server-only; never expose to the browser.
ADMIN_EMAILS=
# Stock level at or below which a product counts as low stock in the admin (default 3).
LOW_STOCK_THRESHOLD=3
PRODUCT_IMAGE_HOSTS=

# All image and video binaries are stored in Cloudinary; Appwrite stores only metadata/URLs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=silveram

# Must be true for customers to place orders (cash on delivery needs only this).
# Complete product, stock, policy and staging checks before turning it on.
STORE_LIVE_CHECKOUT=false
# Cash on delivery: on by default when checkout is live. Set false to switch it off.
COD_ENABLED=true
# Dummy card payments for testing the full checkout. Needs STORE_LIVE_CHECKOUT=true. TURN OFF BEFORE LAUNCH.
PAYMENT_TEST_MODE=false
CASHFREE_ENABLED=false
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

# Mailjet powers verification/order email over SMTP and optional newsletter contact sync.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_CONTACT_LIST_ID=
SMTP_FROM="Silveram <orders@your-validated-domain.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
STORE_NAME=Silveram
STORE_URL=
SUPPORT_EMAIL=

# Cashfree Payment Gateway (UPI, UPI QR, cards). Dashboard > Developers > API Keys.
# Sandbox keys + CASHFREE_ENV=sandbox for testing; production keys + CASHFREE_ENV=production to go live.
# Webhooks are signed with the same secret key. In the Cashfree dashboard (Developers > Webhooks)
# add: <STORE_URL>/api/webhooks/cashfree  (STORE_URL must be set and https).
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
